PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/yojanadut

JWT_SECRET=yojanadut_super_secret_jwt_key_2026_maha_seva_connect
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5175

ADMIN_PHONE=9579224223
ADMIN_EMAIL=sanviinfotechcsc@gmail.com
WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/CPGUrVqOf2I4ZzsvBivj6e?s=sw&p=a&mlu=4&ilr=4

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

# SMS / OTP Gateway (Fast2SMS / Twilio)
FAST2SMS_API_KEY=your_fast2sms_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Cloud Storage (Cloudinary / S3)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your_s3_bucket_name

# Email Notifications / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sanviinfotechcsc@gmail.com
SMTP_PASS=your_gmail_app_password
